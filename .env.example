# Copy to `.env` at the project root and fill real values.
# Never commit real passwords or DJANGO_SECRET_KEY.

QA_USE_EXTERNAL_DB=true
QA_EXTERNAL_SCHEMA=db_external_data

QA_DB_NAME=
QA_DB_USER=
QA_DB_PASSWORD=
QA_DB_HOST=127.0.0.1
QA_DB_PORT=5432

# Django / auth security
# Production MUST set:
#   DEBUG=false
#   USE_HTTPS=true
#   strong DJANGO_SECRET_KEY
#   real ALLOWED_HOSTS / CORS_ORIGINS / CSRF_TRUSTED_ORIGINS
#   FRONTEND_APP_URL=https://your-qa-host
#   DJANGO_DB_ENGINE=django.db.backends.postgresql (+ NAME/USER/PASSWORD/HOST)
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DEBUG=true
USE_HTTPS=false
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ALLOW_CLOUDFLARE_TUNNEL_CORS=false

# Optional Django auth DB (defaults to SQLite when unset). Production: use Postgres.
# DJANGO_DB_ENGINE=django.db.backends.postgresql
# DJANGO_DB_NAME=daq_auth
# DJANGO_DB_USER=
# DJANGO_DB_PASSWORD=
# DJANGO_DB_HOST=127.0.0.1
# DJANGO_DB_PORT=5432
# DJANGO_DB_CONN_MAX_AGE=60
# DJANGO_DB_SSLMODE=require

# External (domain) Postgres TLS — prefer require/verify-full in production
QA_DB_SSLMODE=prefer
QA_DB_CONNECT_TIMEOUT=8

# Managed-user / login emails must use one of these domains (comma-separated).
ALLOWED_EMAIL_DOMAINS=detroitaxle.com
# Frontend mirror (Manage Users validation):
# VITE_ALLOWED_EMAIL_DOMAINS=detroitaxle.com

# Seed commands (never commit real passwords)
# SUPERADMIN_PASSWORD=
# DEMO_USER_PASSWORD=
# TEMP_EMPLOYEE_PASSWORD=

# Power Automate HTTP trigger URLs (server-side only — never expose to the browser)
# Create Instant cloud flows with "When an HTTP request is received", then paste each URL here.
#
# monitoring-email JSON body (sent when a monitoring item is created):
#   {
#     "id", "order", "agentId", "agentName", "agentEmail", "toEmail",
#     "team", "teamLabel", "comment", "createdAt", "createdAtLabel",
#     "monitoringUrl"
#   }
# Outlook To:  triggerBody()?['toEmail']
#   - Production: same as agentEmail (employee)
#   - Testing: set POWER_AUTOMATE_TEST_EMAIL to your address (redirects To)
# HTML body:   paste design/emails/monitoring-email.power-automate.html
#
# avg-email: batch quality averages — paste design/emails/qa-avg-email.power-automate.html
#
# share-audit JSON body (Audit details → Share with agent):
#   {
#     "auditId", "agentId", "agentName", "agentEmail", "toEmail",
#     "team", "teamLabel", "score", "caseType",
#     "auditDate", "auditDateLabel", "auditUrl", "sharedBy", "emailTestMode"
#   }
# Outlook To:  triggerBody()?['toEmail']
# HTML body:   paste design/emails/share-audit.power-automate.html
# Link href:   triggerBody()?['auditUrl']  (employee portal deep link)
#
# forgot-password JSON body (sent from /api/auth/forgot-password/):
#   {
#     "email", "agentEmail", "agentName", "agentId",
#     "toEmail", "resetUrl", "expiresInHours", "emailTestMode"
#   }
# Outlook To:  triggerBody()?['toEmail']
# HTML body:   paste design/emails/forgot-password.power-automate.html
# Button href: triggerBody()?['resetUrl']
POWER_AUTOMATE_AVG_EMAIL_WEBHOOK=
POWER_AUTOMATE_MONITORING_WEBHOOK=
POWER_AUTOMATE_SHARE_AUDIT_WEBHOOK=
POWER_AUTOMATE_FORGOT_PASSWORD_WEBHOOK=

# Testing only — leave blank in production so emails go to the employee
# POWER_AUTOMATE_TEST_EMAIL=you@detroitaxle.com
# Client emailTestMode overrides are only honored when this is true (defaults to DEBUG):
# ALLOW_EMAIL_TEST_OVERRIDE=false

# Public app origin used in email deep links (required when DEBUG=false)
# FRONTEND_APP_URL=https://qa.example.com
# Optional alias (same purpose):
# VITE_APP_URL=https://qa.example.com

# Production (Docker): see README “Production deploy”
#   docker compose up --build
# Local packaged SPA without Docker:
#   cd web && npm run build
#   cd backend && python manage.py collectstatic --noinput
#   gunicorn config.wsgi:application --bind 0.0.0.0:8000 --workers 3
